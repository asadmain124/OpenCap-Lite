{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencap-lite/ocf/issuance",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "object_type", "stakeholder_id"],
    "properties": {
      "id": { "type": "string" },
      "object_type": {
        "type": "string",
        "enum": ["TX_STOCK_ISSUANCE", "TX_EQUITY_COMPENSATION_ISSUANCE", "TX_CONVERTIBLE_ISSUANCE"]
      },
      "stakeholder_id": { "type": "string" },
      "stock_class_id": { "type": "string" },
      "quantity": { "type": "string" },
      "share_price": {
        "type": "object",
        "properties": {
          "amount": { "type": "string" },
          "currency": { "type": "string" }
        }
      },
      "date": { "type": "string" },
      "option_grant_type": { "type": "string" },
      "convertible_type": { "type": "string" },
      "conversion_triggers": { "type": "array" },
      "investment_amount": {
        "type": "object",
        "properties": {
          "amount": { "type": "string" },
          "currency": { "type": "string" }
        }
      }
    }
  }
}
