generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------- Models --------------------

model Company {
  id                        String   @id @default(cuid())
  legalName                 String
  jurisdiction              String
  incorporationDate         DateTime?
  authorizedCommonShares    BigInt   @default(0)
  authorizedPreferredShares BigInt   @default(0)
  defaultCurrency           String   @default("USD")
  settings                  String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  stakeholders     Stakeholder[]
  securityClasses  SecurityClass[]
  holdings         EquityHolding[]
  optionGrants     OptionGrant[]
  safes            SAFEInstrument[]
  notes            ConvertibleNote[]
  scenarios        Scenario[]
  auditLogs        AuditLog[]
}

model Stakeholder {
  id        String           @id @default(cuid())
  companyId String
  type      String
  name      String
  email     String?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  holdings     EquityHolding[]
  optionGrants OptionGrant[]
  safes        SAFEInstrument[]
  convertibleNotes ConvertibleNote[]

  @@index([companyId])
}

model SecurityClass {
  id                            String        @id @default(cuid())
  companyId                     String
  name                          String
  type                          String
  seniorityOrder                Int           @default(0)
  authorizedShares              BigInt?
  liquidationPreferenceMultiple Decimal?
  participationRights           Boolean       @default(false)
  reservedUngrantedShares       BigInt?       @default(0)
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  holdings EquityHolding[]

  @@index([companyId])
}

model EquityHolding {
  id                     String             @id @default(cuid())
  companyId              String
  stakeholderId          String
  securityClassId        String
  shareCount             BigInt
  pricePaidPerShare      Decimal?
  issueDate              DateTime
  status                 String      @default("ACTIVE")
  vestingStartDate       DateTime?
  vestingCliffMonths     Int?
  vestingDurationMonths  Int?
  vestingFrequency       String   @default("NONE")
  certificateNumber      String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stakeholder   Stakeholder   @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  securityClass SecurityClass @relation(fields: [securityClassId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([stakeholderId])
}

model OptionGrant {
  id                    String            @id @default(cuid())
  companyId             String
  stakeholderId         String
  optionCount           BigInt
  exercisedCount        BigInt            @default(0)
  cancelledCount        BigInt            @default(0)
  strikePrice           Decimal
  grantDate             DateTime
  expirationDate        DateTime?
  status                String @default("ACTIVE")
  vestingStartDate      DateTime?
  vestingCliffMonths    Int?
  vestingDurationMonths Int?
  vestingFrequency      String  @default("NONE")
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([stakeholderId])
}

model SAFEInstrument {
  id                String     @id @default(cuid())
  companyId         String
  stakeholderId     String
  issueDate         DateTime
  purchaseAmount    Decimal
  valuationCap      Decimal?
  discountPercent   Decimal?
  mfn               Boolean    @default(false)
  postMoney         Boolean    @default(true)
  proRataRights     Boolean    @default(false)
  status            String @default("OUTSTANDING")
  sideLetterNotes   String?
  currency          String     @default("USD")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([stakeholderId])
}

model ConvertibleNote {
  id                           String       @id @default(cuid())
  companyId                    String
  stakeholderId                String
  issueDate                    DateTime
  maturityDate                 DateTime?
  principal                    Decimal
  annualInterestRatePercent    Decimal      @default(0)
  interestType                 String @default("SIMPLE")
  compoundingFrequencyPerYear  Int?
  valuationCap                 Decimal?
  discountPercent              Decimal?
  mfn                          Boolean      @default(false)
  status                       String   @default("OUTSTANDING")
  currency                     String       @default("USD")
  notes                        String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([stakeholderId])
}

model Scenario {
  id            String       @id @default(cuid())
  companyId     String
  name          String
  description   String?
  baselineMode  String @default("LIVE_CAP_TABLE")
  snapshotJson  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company              Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roundInput           ScenarioRoundInput?
  newInstrumentInputs  ScenarioNewInstrumentInput[]

  @@index([companyId])
}

model ScenarioRoundInput {
  id                              String                   @id @default(cuid())
  scenarioId                      String                   @unique
  roundType                       String                @default("PRICED_ROUND")
  preMoneyValuation               Decimal?
  newMoney                        Decimal?
  pricedRoundPricePerShareOverride Decimal?
  roundCloseDate                  DateTime?
  optionPoolTopUpMode             String      @default("NONE")
  optionPoolTargetPercent         Decimal?
  optionPoolFixedShares           BigInt?
  optionPoolFixedPercentPreMoney  Decimal?
  capDenominatorMethod            String     @default("CURRENT_FULLY_DILUTED")
  capDenominatorOverride          BigInt?
  preMoneyDenominatorMethod       String @default("CURRENT_FULLY_DILUTED")
  preMoneyDenominatorOverride     BigInt?
  conversionOrderingRule          String   @default("CONVERTIBLES_THEN_POOL_TOPUP_THEN_NEW_MONEY")
  notesConvertUsing               String        @default("BEST_FOR_INVESTOR")
  safesConvertUsing               String        @default("BEST_FOR_INVESTOR")
  mfnFallback                     String?
  includeProRata                  Boolean                  @default(false)
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model ScenarioNewInstrumentInput {
  id         String            @id @default(cuid())
  scenarioId String
