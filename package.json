{
  "name": "opencap-lite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm db:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:sync:sqlite": "tsx scripts/sync-sqlite-schema.ts",
    "db:sync:sqlite:check": "tsx scripts/sync-sqlite-schema.ts --check",
    "db:generate:sqlite": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "db:migrate:sqlite": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "db:migrate:sqlite:deploy": "prisma migrate deploy --schema=prisma/sqlite/schema.prisma",
    "electron:tsc": "tsc -p electron/tsconfig.json",
    "desktop:template-db": "tsx scripts/build-template-db.ts",
    "desktop:assets": "tsx scripts/prepare-standalone-assets.ts",
    "desktop:build": "pnpm db:sync:sqlite && pnpm db:generate:sqlite && OPENCAP_BUILD_TARGET=electron next build && pnpm desktop:assets && pnpm electron:tsc && pnpm desktop:template-db",
    "electron:dev": "pnpm desktop:build && electron electron/dist/main.js",
    "desktop:dist": "pnpm desktop:build && electron-builder --mac --config electron-builder.yml",
    "e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-table": "^8.20.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "recharts": "^2.13.3",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "fast-check": "^3.23.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "electron",
      "electron-winstaller",
      "prisma"
    ]
  }
}
